OPERATIVE PROFILE  : KAEL
ACTIVE ARSENAL     : DUAL REVOLVER

SURVIVAL DURATION  : 00:00
AUTOMATONS PURGED  : 0 UNITS
OVERCLOCK LEVEL    : LVL 01"
autowrap_mode = 2

[node name="HBoxBtns" type="HBoxContainer" parent="CenterContainer/PanelContainer/Margin/VBox"]
