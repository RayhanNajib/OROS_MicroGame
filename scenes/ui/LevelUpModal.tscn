[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/level_up_modal.gd" id="1_scr"]
[ext_resource type="AudioStream" path="res://assets/audio/sfx_levelup.wav" id="2_lvl_sfx"]
[ext_resource type="AudioStream" path="res://assets/audio/sfx_menu_click.wav" id="3_click_sfx"]
[ext_resource type="FontFile" path="res://assets/fonts/PressStart2P-Regular.ttf" id="4_font"]

[node name="LevelUpModal" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_scr")

[node name="DimOverlay" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.06, 0.92)

[node name="CenterContainer" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="PanelContainer" type="PanelContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(1150, 580)
layout_mode = 2

[node name="MarginContainer" type="MarginContainer" parent="CenterContainer/PanelContainer"]
layout_mode = 2
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="CenterContainer/PanelContainer/MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="Label" parent="CenterContainer/PanelContainer/MarginContainer/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.25, 1)
theme_override_fonts/font = ExtResource("4_font")
theme_override_font_sizes/font_size = 17
text = "[ SYSTEM OVERCLOCK // SELECT UPGRADE MODULE ]"
horizontal_alignment = 1

[node name="Sub" type="Label" parent="CenterContainer/PanelContainer/MarginContainer/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.85, 1, 1)
theme_override_fonts/font = ExtResource("4_font")
theme_override_font_sizes/font_size = 10
text = "Pilih 1 modul augmentasi persenjataan operative untuk memperkuat sistem tempur"
horizontal_alignment = 1

[node name="CardsHBox" type="HBoxContainer" parent="CenterContainer/PanelContainer/MarginContainer/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 28
alignment = 1

[node name="SFXLevelUp" type="AudioStreamPlayer" parent="."]
