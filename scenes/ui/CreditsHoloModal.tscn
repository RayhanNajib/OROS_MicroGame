[node name="GuideText" type="Label" parent="UIOverlay/Margin/VBox/ControlsGuideBox/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.9, 0.95, 1, 1)
theme_override_fonts/font = ExtResource("4_tech")
theme_override_font_sizes/font_size = 18
text = "• [W, A, S, D] / Tombol Panah: Gerak Karakter Operative (WASD 8-Directional Movement)
• [SPACE / SHIFT / TAHAN E]: Bidik & Eksekusi Skill Karakter (Cryo Dash, Decoy Blink, Seismic Slam, Singularity)
• [MOUSE / KURSOR]: Arah Bidik Senjata Jarak Jauh & Tebasan Melee
• [KLIK KIRI]: Tembak Peluru Senjata Primer (Ranged)
• [KLIK KANAN / Q / 1, 2]: Ganti Senjata Cepat (Slot 1 Ranged <-> Slot 2 Melee Katana, CD 0.35s)
• [R]: Reload Magasin Manual (Animasi Slide Bar di Atas Kepala Karakter)
• [ESC]: Jeda Pertempuran / Menu Pengaturan Audio & Return to Terminal
• [NUMPAD 1, 2]: Shortcut Alternatif Pergantian Senjata

ATURAN BALANCING RESMI:
- Pemulihan HP (Medkit) HANYA jatuh dari tebasan senjata Melee (35% drop rate). Ranged kill 0% drop medkit!
- Dash karakter murni manuver mobilitas & freeze (tidak menghapus musuh 1 layar instan)."
autowrap_mode = 2

