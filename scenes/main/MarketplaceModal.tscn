[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/main/marketplace_modal.gd" id="1_scr"]
[ext_resource type="FontFile" path="res://assets/fonts/Orbitron-Bold.ttf" id="2_orb"]
[ext_resource type="FontFile" path="res://assets/fonts/PixelifySans-Regular.ttf" id="3_pix"]
[ext_resource type="AudioStream" path="res://assets/audio/sfx_menu_click.wav" id="4_click"]

[node name="MarketplaceModal" type="ColorRect"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.04, 0.08, 0.96)
script = ExtResource("1_scr")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(1050, 720)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="CenterContainer/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 28

[node name="VBox" type="VBoxContainer" parent="CenterContainer/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="HeaderBox" type="HBoxContainer" parent="CenterContainer/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="CenterContainer/Panel/Margin/VBox/HeaderBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.2, 0.9, 1, 1)
theme_override_fonts/font = ExtResource("2_orb")
theme_override_font_sizes/font_size = 18
text = "[ CYBER ARMORY // MARKETPLACE KOSMETIK ]"

[node name="CreditsLabel" type="Label" parent="CenterContainer/Panel/Margin/VBox/HeaderBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.25, 1)
theme_override_fonts/font = ExtResource("2_orb")
theme_override_font_sizes/font_size = 14
text = "SALDO: 300 NANO-CREDITS"

[node name="Sub" type="Label" parent="CenterContainer/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.85, 1, 1)
theme_override_fonts/font = ExtResource("3_pix")
theme_override_font_sizes/font_size = 12
text = "Tukarkan Nano-Credits hasil misi survival untuk membuka skin Hero, skin Senjata, dan model Core EXP."

[node name="Scroll" type="ScrollContainer" parent="CenterContainer/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 480)
layout_mode = 2
size_flags_vertical = 3

[node name="ItemsGrid" type="GridContainer" parent="CenterContainer/Panel/Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 18
theme_override_constants/v_separation = 16
columns = 2

[node name="CloseBtn" type="Button" parent="CenterContainer/Panel/Margin/VBox"]
custom_minimum_size = Vector2(300, 48)
layout_mode = 2
size_flags_horizontal = 4
theme_override_fonts/font = ExtResource("2_orb")
theme_override_font_sizes/font_size = 12
text = "[ KEMBALI KE TERMINAL ]"

[node name="SFXClick" type="AudioStreamPlayer" parent="."]
stream = ExtResource("4_click")
