;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="O.R.O.S.: Overclocked Roguelite On Survivor"
config/description="Twin-Stick Roguelite Survivor Mechanics (Inspired by 20 Minutes Till Dawn) - Team: M. Rayhan Najib, Luigy M. C. Liem Saunoah, Ahmad Faizun"
config/version="1.0.0"
run/main_scene="res://scenes/main/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.0470588, 0.0627451, 0.101961, 1)

[autoload]

GameState="*res://scripts/autoload/game_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

